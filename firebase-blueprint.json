{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "A shopping item in the store",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "oldPrice": { "type": "number" },
        "imageUrl": { "type": "string" },
        "category": { "type": "string" },
        "isSale": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "price", "imageUrl"]
    },
    "UserProfile": {
      "title": "User Profile",
      "description": "User account information and cart",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "cart": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "productId": { "type": "string" },
              "quantity": { "type": "number" }
            }
          }
        },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Store products"
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profiles and carts"
    }
  }
}
